# ── Market Terminal — environment variables ───────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# Only MACRO_DB_URL is required for core market views to work.
# Everything else is optional — features degrade gracefully when absent.
#
# Source of truth: the fred-bronze-to-gold-pipeline produces fred_local.db
# (SQLite) locally, or publishes to Postgres for Render/cloud deployments.
# ─────────────────────────────────────────────────────────────────────────────


# ── Gold DB (required) ────────────────────────────────────────────────────────

# SQLite (local dev — path to fred-bronze-to-gold-pipeline output):
MACRO_DB_URL=sqlite:../fred-bronze-to-gold-pipeline/fred_local.db

# Postgres (Render / cloud deploy):
# MACRO_DB_URL=postgres://user:password@host:5432/dbname

# Databricks Delta (set MACRO_DB_BACKEND=databricks and fill these):
# MACRO_DB_BACKEND=databricks
# DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# MACRO_CATALOG=macro_prod   # default: macro_prod


# ── Market snapshot fallback ──────────────────────────────────────────────────

# Set to 1 to serve the committed build-time snapshots when the gold DB
# returns no rows for a market view (market, rates, regime, etc.).
# Off by default — prefer an explicit error over silently stale data.
# MARKET_SNAPSHOT_FALLBACK=0


# ── FRED live API (optional) ──────────────────────────────────────────────────

# Used by econ routes as a lower fallback when gold DB rows are absent,
# and by /api/econ/calendar (no gold tier yet — see docs/gaps/GOLD_DB_MIGRATION_REMAINING_GAPS.md §G1).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=


# ── News providers (optional — all four tried in order until one succeeds) ───

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Marketaux — https://www.marketaux.com/
# MARKETAUX_API_KEY=

# Finnhub — https://finnhub.io/ (also used by /api/econ/calendar)
# FINNHUB_API_KEY=

# NewsAPI — https://newsapi.org/
# NEWSAPI_API_KEY=

# FinBERT NLP service (re-scores headlines; empty → keyword clustering only)
# NEWS_NLP_URL=http://localhost:8001


# ── Social sentiment (optional) ───────────────────────────────────────────────

# StockTwits
# STOCKTWITS_ENABLED=1
# STOCKTWITS_ACCESS_TOKEN=

# Reddit (user-agent string, e.g. "MarketTerminal/1.0 by YourUsername")
# REDDIT_USER_AGENT=

# AAII Sentiment feed URL (if self-hosted)
# AAII_SENTIMENT_URL=


# ── Cron cache-warming (optional) ─────────────────────────────────────────────

# Secret passed in the Authorization header by the /api/cron/refresh route.
# Required if you deploy the cron warmer — set the same value in your scheduler.
# CRON_SECRET=
# CRON_TARGET_URL=https://your-deploy-url.onrender.com


# ── AI features (optional) ────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=


# ── Infrastructure (auto-set on Vercel / Render; only needed for self-host) ───

# PORT=3000
# HOST=0.0.0.0


# ── Deprecated — do not set (decommissioned sources) ─────────────────────────

# These env vars were used by the Yahoo/market_data_pipeline stack that was
# removed. Setting them has no effect but may cause confusing health-check
# output in /api/dataops/health until that route is cleaned up (see G5 in
# docs/gaps/GOLD_DB_MIGRATION_REMAINING_GAPS.md).
#
# MARKET_DB_URL        ← Yahoo DuckDB path (removed)
# MARKET_PIPELINE_URL  ← market_data_pipeline Flask API (removed)
# MARKET_DATA_DIR      ← pipeline Parquet output directory (removed)
